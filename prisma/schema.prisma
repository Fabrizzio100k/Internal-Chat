generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DB_URL")
  directUrl = env("DIRECT_URL")
}

enum ParticipantRole {
  MEMBER
  ADMIN
}

enum ChatRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sentRequests     ChatRequest[] @relation("SentRequests")
  receivedRequests ChatRequest[] @relation("ReceivedRequests")

  participations ConversationParticipant[]

  messages    Message[]
  attachments Attachment[]

  key UserKey?

  // Última versión de la app cuyo "qué hay de nuevo" ya vio el usuario (no volver a mostrarlo).
  lastSeenVersion String?
  sessions        UserSession[]
  receivedConversationKeys ConversationKey[] @relation("KeyRecipient")
  issuedConversationKeys   ConversationKey[] @relation("WrappedKeys")

  @@map("users")
}

// Una fila por inicio de sesión (dispositivo). El JWT de la cookie lleva este id
// (`sid`): si la fila se revoca o expira, la cookie deja de valer aunque su firma sea válida.
model UserSession {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // "Chrome en Windows": derivado del User-Agent en el servidor.
  deviceName String
  deviceType String    @default("desktop")
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

// Claves E2EE del usuario. El servidor SOLO guarda claves públicas y las
// privadas ya cifradas en el navegador con una clave derivada de la contraseña
// (el servidor nunca puede descifrarlas).
model UserKey {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SPKI en base64.
  ecdhPublicKey        String
  signPublicKey        String
  // base64(iv || AES-GCM(pkcs8 ecdh + pkcs8 sign)).
  encryptedPrivateKeys String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_keys")
}

// Clave simétrica de una conversación para UN miembro y UNA época, cifrada para
// su clave pública (ECIES) y firmada por quien la repartió. Al entrar o salir
// alguien se crea una época nueva; las épocas viejas se conservan para el historial.
model ConversationKey {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  epoch          Int
  user           User         @relation("KeyRecipient", fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  wrappedKey     String
  wrappedBy      User         @relation("WrappedKeys", fields: [wrappedById], references: [id], onDelete: Cascade)
  wrappedById    String
  signature      String
  createdAt      DateTime     @default(now())

  @@unique([conversationId, epoch, userId])
  @@index([userId, conversationId])
  @@map("conversation_keys")
}

model ChatRequest {
  id         String            @id @default(cuid())
  fromUser   User              @relation("SentRequests", fields: [fromUserId], references: [id])
  fromUserId String
  toUser     User              @relation("ReceivedRequests", fields: [toUserId], references: [id])
  toUserId   String
  status     ChatRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([fromUserId, toUserId])
  @@map("chat_requests")
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // false = chat 1:1 (name null). true = grupo con nombre.
  isGroup     Boolean  @default(false)
  name        String?
  createdById String?

  // Época de la clave E2EE vigente. 0 = aún sin clave (conversación previa al E2EE
  // o recién creada). Sube en 1 cada vez que cambia la membresía.
  currentEpoch       Int     @default(0)
  // true cuando alguien salió y falta rotar la clave (la rota el siguiente cliente que la use).
  keyRotationPending Boolean @default(false)

  participants ConversationParticipant[]
  messages     Message[]
  keys         ConversationKey[]

  @@map("conversations")
}

// Relación muchos-a-muchos entre User y Conversation. Cada fila representa
// la membresía de un usuario en una conversación, junto con su propio
// lastReadAt (para calcular mensajes no leídos por usuario). Este diseño
// es el estándar para apps de mensajería porque:
// - Cada participante tiene su propio estado de lectura, sin condicionales
//   "soy A o soy B" en el código.
// - Escala directo a conversaciones grupales sin cambiar el esquema
//   (agregar más filas ConversationParticipant a la misma Conversation).
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  role           ParticipantRole @default(MEMBER)
  // Chat fijado arriba de la lista. Es por usuario; null = no fijado.
  pinnedAt       DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String
  // Texto en claro: SOLO mensajes de sistema (kind != null) y mensajes anteriores
  // al E2EE que aún no se migraron. Los mensajes normales van en `ciphertext`.
  content        String?
  // E2EE: base64(iv || AES-GCM(payload) || firma). El servidor no puede leerlo.
  ciphertext     String?
  keyEpoch       Int?
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  // Mensajes de sistema de grupos (kind != null): "group_created", "member_added",
  // "member_removed", "member_left", "group_renamed". targetUserIds = usuarios
  // afectados; el sidebar en tiempo real lo usa para añadir/quitar el chat.
  kind           String?
  targetUserIds  String[]     @default([])

  attachments Attachment[]

  @@index([conversationId, createdAt])
  // Sincronización del índice de búsqueda: "¿hubo ediciones/borrados desde X?" sin escanear el chat.
  @@index([conversationId, editedAt])
  @@index([conversationId, deletedAt])
  @@map("messages")
}

model Attachment {
  id         String   @id @default(cuid())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId  String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  uploaderId String
  // Metadatos en claro: SOLO adjuntos anteriores al E2EE. En los cifrados el nombre,
  // tipo y tamaño real viajan dentro del mensaje cifrado y estos campos son null.
  fileName   String?
  fileType   String?
  fileSize   Int?
  storagePath String
  // E2EE: identificador aleatorio (último tramo de storagePath) que liga el adjunto
  // con su entrada dentro del mensaje cifrado, y tamaño del blob cifrado en S3.
  ref        String?
  encSize    Int?
  createdAt  DateTime @default(now())

  @@index([messageId])

  @@map("attachments")
}

// Rate limiting basado en Postgres (sin Redis/infra adicional). Cada fila
// representa el conteo de requests de una IP para un endpoint específico
// dentro de la ventana de tiempo actual. `key` combina ip+endpoint para que
// cada endpoint tenga su propio límite independiente por IP.
model RateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
  @@map("rate_limits")
}
